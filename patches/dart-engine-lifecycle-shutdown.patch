diff --git a/runtime/engine/engine.cc b/runtime/engine/engine.cc
--- a/runtime/engine/engine.cc
+++ b/runtime/engine/engine.cc
@@ -264,4 +264,17 @@ void Engine::Shutdown() {
     UnlockIsolate(isolate);
   }
-
+
+  // Workers created by Isolate.spawn belong to the root isolate group but are
+  // not present in isolates_, which contains only roots created through
+  // DartEngine_CreateIsolate. VM-wide cleanup must complete before snapshot
+  // storage is released so a surviving worker cannot execute freed code.
+  if (first_isolate_started_) {
+    char* cleanup_error = Dart_Cleanup();
+    if (cleanup_error != nullptr) {
+      Syslog::PrintErr("Dart Engine cleanup failed: %s\n", cleanup_error);
+      free(cleanup_error);
+    }
+    first_isolate_started_ = false;
+  }
+
   MutexLocker state_locker(&engine_state_);
@@ -279,2 +292,6 @@ void Engine::Shutdown() {
   }
+  owned_snapshots_.clear();
+  loaded_libraries_.clear();
+  isolates_.clear();
+  isolate_data_.clear();
 }
