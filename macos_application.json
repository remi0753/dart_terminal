{
  "schemaVersion": 1,
  "application": {
    "name": "DartTerminal",
    "executableName": "dart_terminal",
    "bundleIdentifier": "dev.dart-terminal",
    "version": "0.1.0",
    "minimumSystemVersion": "14.0"
  },
  "services": [
    {
      "kind": "newTabAtFolder",
      "menuItem": "New Dart Terminal Tab Here"
    },
    {
      "kind": "newWindowAtFolder",
      "menuItem": "New Dart Terminal Window Here"
    }
  ],
  "runner": {
    "activationPolicy": "regular",
    "activateOnLaunch": true,
    "terminateAfterLastWindowClosed": false,
    "reopenHandled": true,
    "messagePump": {
      "maxMessagesPerTurn": 64,
      "maxTimePerTurnMicros": 4000
    }
  },
  "dart": {"entrypoint": "bin/main.dart"},
  "dartHelpers": [
    {
      "name": "dart_terminal_runtime_worker",
      "entrypoint": "bin/runtime_worker.dart"
    }
  ],
  "resources": [
    "resources/terminfo/78/xterm-256color",
    "resources/shell-integration/contract.json",
    "resources/shell-integration/zsh/.zshenv",
    "resources/shell-integration/zsh/dart-terminal-integration.zsh",
    "resources/shell-integration/bash/dart-terminal-integration.bash",
    "resources/shell-integration/fish/vendor_conf.d/dart-terminal-integration.fish",
    "resources/shell-integration/nushell/vendor/autoload/dart_terminal.nu"
  ],
  "nativeAssets": [
    {
      "id": "dart_pty_macos",
      "package": "dart_pty_macos",
      "library": "libdart_pty_macos.dylib",
      "abiVersion": 2,
      "abiVersionSymbol": "dpty_abi_version"
    }
  ],
  "nativeCapabilities": [
    {
      "id": "dart_terminal_renderer_macos",
      "package": "dart_terminal_renderer_macos",
      "library": "libdart_terminal_renderer_macos.dylib",
      "abiVersion": 10,
      "abiVersionSymbol": "dtr_abi_version",
      "initializerSymbol": "dtr_initialize"
    }
  ],
  "diagnostics": {
    "enabled": true,
    "applicationSupportName": "Dart Terminal"
  }
}
