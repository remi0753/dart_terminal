      "snapshot": [
        "OSC \"\\e]0;title\\a\"",
        "OSC \"\\e]8;;https://example\\e\\\\\"",
        "DCS \"\\eP$qm\\e\\\\\"",
        "APC \"\\e_payload\\e\\\\\""
      ]
    },
    {
      "id": "cancel-and-recover",
      "description": "CAN and SUB cancel incomplete CSI/OSC and printable input recovers",
      "input_hex": "1b 5b 31 32 3b 33 34 18 4f 4b 1b 5d 62 61 64 1a 5a",
      "snapshot": [
        "CANCEL state=csi byte=CAN",
        "TEXT \"OK\"",
        "CANCEL state=osc byte=SUB",
        "TEXT \"Z\""
      ]
    },
