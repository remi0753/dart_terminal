    {
      "id": "c0-and-escape",
      "description": "C0 execution and two simple ESC dispatches retain ordering",
      "input_hex": "41 0d 0a 1b 37 1b 38 42",
      "snapshot": [
        "TEXT \"A\"",
        "EXEC CR (0x0d)",
        "EXEC LF (0x0a)",
        "ESC \"\\e7\"",
        "ESC \"\\e8\"",
        "TEXT \"B\""
      ]
    },
    {
      "id": "csi-parameters",
      "description": "semicolon parameters and colon-form SGR remain byte-exact in dispatch",
