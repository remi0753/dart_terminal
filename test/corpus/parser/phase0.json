      "snapshot": [
        "CSI \"\\e[31;1m\"",
        "TEXT \"red\"",
        "CSI \"\\e[0m\"",
        "CSI \"\\e[38:2::1:2:3m\"",
        "TEXT \"X\""
      ]
    },
    {
      "id": "string-protocols",
      "description": "OSC BEL/ST, DCS ST, and APC ST terminate incrementally",
